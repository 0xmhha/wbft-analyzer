          "kind": {
            "type": "string"
          },
          "mode": {
            "enum": [
              "absolute",
              "relative"
            ],
            "type": "string"
          },
          "node": {
            "type": "string"
          },
          "threshold": {
            "format": "double",
            "type": "number"
          },
          "webhook": {
            "type": "string"
          },
          "window": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "baseline",
          "kind",
          "mode",
          "node",
          "threshold",
          "webhook",
          "window"
